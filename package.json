{
  "name": "@microsoft/typespec-graph-docs-emitter",
  "version": "0.1.0",
  "description": "TypeSpec emitter that generates Markdown API reference documentation for Microsoft Graph APIs",
  "type": "module",
  "main": "dist/src/index.js",
  "tspMain": "lib/decorators.tsp",
  "exports": {
    ".": {
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "alloy build",
    "test": "vitest run",
    "test:watch": "vitest -w",
    "clean": "rimraf dist/",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@alloy-js/cli": "^0.23.0",
    "@alloy-js/rollup-plugin": "^0.1.1",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@typespec/compiler": "^1.12.0"
  },
  "dependencies": {
    "@typespec/emitter-framework": "^0.16.0"
  },
  "peerDependencies": {
    "@alloy-js/core": "^0.22.0",
    "@microsoft/typespec-msgraph": "^1.0.3",
    "@typespec/compiler": "^1.12.0"
  }
}
